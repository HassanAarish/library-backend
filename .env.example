# LibraryHub backend — copy this file to .env and fill in your values.
#   cp .env.example .env
# The server checks these on startup (config/env.js): a missing or malformed
# REQUIRED value stops it with a clear list; OPTIONAL features only warn.
# Never commit the real .env.

# ---------------------------------------------------------------------------
# Core (REQUIRED)
# ---------------------------------------------------------------------------
NODE_ENV=development                  # development | production
PORT=5001                             # the frontend uses localhost:5001 in dev
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>
SECRET_KEY=<long-random-string-at-least-32-characters>
ACCESS_TOKEN_EXPIRATION=30d           # optional; JWT lifetime

# Frontend address: used in password-reset links and as the CORS origin.
# Optional in development (warns), REQUIRED in production.
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=https://libraryhub.pk,https://www.libraryhub.pk   # optional; overrides CLIENT_URL for CORS

# ---------------------------------------------------------------------------
# Email / SMTP (REQUIRED) — OTP codes, password resets, notifications
# ---------------------------------------------------------------------------
EMAIL=<smtp-account-email>
PASSWORD=<smtp-app-specific-password>
# EMAIL_HOST=smtp.gmail.com           # optional; defaults to iCloud (smtp.mail.me.com)
# EMAIL_PORT=465                      # optional; defaults to 587

# ---------------------------------------------------------------------------
# Cloudinary (REQUIRED) — covers, profile pictures, private book PDFs, payment screenshots
# Also enable "Allow delivery of PDF and ZIP files" in Cloudinary security settings.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# ---------------------------------------------------------------------------
# Payments — Easypaisa, manual verification (OPTIONAL, set both or neither)
# Until both are set, paid bookings and package purchases return 503.
# ---------------------------------------------------------------------------
EASYPAISA_ACCOUNT_TITLE=<name-on-the-easypaisa-account>
EASYPAISA_ACCOUNT_NUMBER=03XXXXXXXXX  # 11-digit mobile number

# ---------------------------------------------------------------------------
# Social login (OPTIONAL) — leave empty to disable a provider
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<google-oauth-client-id>
FACEBOOK_APP_ID=<facebook-app-id>     # set both Facebook values or neither
FACEBOOK_APP_SECRET=<facebook-app-secret>

# ---------------------------------------------------------------------------
# Open Library book lookup (OPTIONAL) — contact address sent in the User-Agent
# ---------------------------------------------------------------------------
# OPENLIBRARY_CONTACT=support@libraryhub.pk   # defaults to EMAIL

# ---------------------------------------------------------------------------
# Two-factor authentication (OPTIONAL)
# ---------------------------------------------------------------------------
# TWO_FA_ISSUER=LibraryHub            # name shown in the authenticator app

# ---------------------------------------------------------------------------
# Redis (OPTIONAL) — shared rate limits, cache and live updates across
# several server instances. Without it everything works in-memory (one instance).
# ---------------------------------------------------------------------------
# REDIS_URL=rediss://default:<password>@<host>:6379

# ---------------------------------------------------------------------------
# Data retention (OPTIONAL)
# ---------------------------------------------------------------------------
# REQUEST_LOG_RETENTION_DAYS=90       # per-request activity logs
# NOTIFICATION_RETENTION_DAYS=180     # in-app notifications

# ---------------------------------------------------------------------------
# Book protection (REQUIRED in production) — limits that spot someone copying
# a book. Pick your own whole numbers, and never commit or publish them.
# ---------------------------------------------------------------------------
# READER_PAGES_PER_MINUTE=
# READER_MAX_NETWORKS=
# READER_NETWORK_WINDOW_MINUTES=
